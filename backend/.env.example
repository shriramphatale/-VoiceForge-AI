# Express API port
PORT=5000

# Python inference service URL (must match python-service HOST:PORT)
PYTHON_SERVICE_URL=http://127.0.0.1:8000

# Shared data directory – must resolve to the same folder the Python service uses
DATA_DIR=../data

# Upload limits
MAX_UPLOAD_MB=25

# Maximum text length for generation requests (characters)
MAX_TEXT_LENGTH=5000

# Timeout for a single generation request to the Python service (ms)
GENERATION_TIMEOUT_MS=300000

# Frontend origin for CORS
FRONTEND_URL=http://localhost:5173
