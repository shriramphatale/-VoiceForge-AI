# XTTS-v2 model identifier (used by Coqui TTS to download/load the model)
XTTS_MODEL_NAME=tts_models/multilingual/multi-dataset/xtts_v2

# Device selection: "auto" (detect GPU), "cuda", or "cpu"
XTTS_DEVICE=auto

# Optional: override the TTS model cache directory
# Defaults to ~/.local/share/tts (Linux) or %LOCALAPPDATA%\tts (Windows)
XTTS_MODEL_DIR=

# Maximum input text length (characters)
MAX_TEXT_LENGTH=5000

# Service binding — 127.0.0.1 prevents external access
HOST=127.0.0.1
PORT=8000

# Shared data directory (must match the backend's DATA_DIR)
DATA_DIR=../data
